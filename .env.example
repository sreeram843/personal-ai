# FastAPI configuration
APP_NAME=personal-ai
DEBUG=false

# Ollama configuration
# For Docker: use http://ollama:11434
# For local: use http://127.0.0.1:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120.0

# Pluggable LLM routing (provider adapters + per-stage model selection)
LLM_DEFAULT_PROVIDER=ollama
LLM_DEFAULT_MODEL=llama3:8b
# Optional OpenAI-compatible provider (LM Studio, vLLM, hosted gateways, etc.)
LLM_OPENAI_BASE_URL=
LLM_OPENAI_API_KEY=
LLM_OPENAI_TIMEOUT=60.0
LLM_PLANNER_PROVIDER=ollama
LLM_PLANNER_MODEL=qwen2.5:3b
LLM_SYNTHESIZER_PROVIDER=ollama
LLM_SYNTHESIZER_MODEL=qwen2.5:7b
LLM_REVIEWER_PROVIDER=ollama
LLM_REVIEWER_MODEL=qwen2.5:3b
LLM_WRITER_PROVIDER=ollama
LLM_WRITER_MODEL=llama3:8b

# Qdrant configuration
# For Docker: use http://qdrant:6333
# For local: use http://127.0.0.1:6333
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=personal_ai_documents
QDRANT_DISTANCE=Cosine
EMBEDDING_DIMENSION=768
DEFAULT_TOP_K=4
# Optional cross-encoder reranker (TEI/HTTP or local sentence-transformers). Off by default.
# RETRIEVAL_CROSS_ENCODER_ENABLED=true
# RETRIEVAL_CROSS_ENCODER_PROVIDER=http
# RETRIEVAL_CROSS_ENCODER_URL=http://reranker:80
# RETRIEVAL_CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
# RETRIEVAL_CROSS_ENCODER_WEIGHT=0.6
# Hybrid dense + keyword recall at Qdrant (MatchText). Default on.
# RETRIEVAL_HYBRID_ENABLED=true

# UI CORS origins (comma separated; include capacitor://localhost for iOS/Android app)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,capacitor://localhost,ionic://localhost

# Portfolio embed demo (/demo — 5 free questions, no login)
DEMO_ENABLED=false
DEMO_MAX_QUESTIONS=5
# DEMO_INTRO=Ask about my work in AI, healthcare engineering, academics, or cricket — or try a live weather/FX question.
# DEMO_CONTEXT_PATH=app/prompts/demo-about.md
# DEMO_FULL_APP_URL=https://app.cura-i.com
# Comma-separated sites allowed to iframe /demo (your portfolio domain(s))
# DEMO_EMBED_ALLOWED_ORIGINS=https://yourname.dev,https://www.yourname.dev
# Tune for local LM Studio context (demo knowledge is split 85% professional / 15% cricket)
# DEMO_CONTEXT_MAX_CHARS=8500
# DEMO_MAX_HISTORY_MESSAGES=6
# DEMO_MAX_OUTPUT_TOKENS=512

# Adapter cache configuration
ENABLE_ADAPTER_CACHE=true
ADAPTER_CACHE_BACKEND=redis
ADAPTER_CACHE_DEFAULT_TTL_SECONDS=60
REDIS_URL=redis://redis:6379/0

# Background workers (Phase 2)
ENABLE_BACKGROUND_WORKERS=false
WORKER_QUEUE_BACKEND=arq
INGEST_ASYNC_MIN_DOCUMENTS=5
INGEST_ASYNC_MIN_BYTES=32768
# INGEST_MAX_DOCUMENT_BYTES=512000
# INGEST_MAX_BATCH_BYTES=2000000
# INGEST_ALLOWED_EXTENSIONS=.txt,.md,.pdf
# Raw upload ceiling for POST /ingest/files (binary bytes before text extraction;
# PDFs carry fonts/images so this is larger than INGEST_MAX_DOCUMENT_BYTES, which
# caps the extracted text that actually gets embedded).
# INGEST_MAX_UPLOAD_BYTES=10000000

# Observability defaults
GRAFANA_ADMIN_PASSWORD=admin

# Optional framework toggles
# Fast single-call chat for trivial prompts; tool-calling agent for /chat and Smart chat tier.
ENABLE_FAST_CHAT=true
ENABLE_TOOL_AGENT=true
ENABLE_OPENAI_API=true
ENABLE_LLAMAINDEX_RAG=false

# Workflow orchestration memory
WORKFLOW_MEMORY_PATH=memory/workflow_sessions.json
WORKFLOW_MEMORY_MAX_ENTRIES=24
WORKFLOW_MEMORY_BACKEND=disk
WORKFLOW_RUNS_PATH=memory/runs
RUN_STORE_BACKEND=disk

# Object storage for raw uploads
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_PATH=memory/uploads
# OBJECT_STORAGE_BACKEND=s3
# OBJECT_STORAGE_BUCKET=personal-ai-uploads
# OBJECT_STORAGE_PREFIX=uploads
# OBJECT_STORAGE_ENDPOINT_URL=
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=

# Live data cache TTLs (seconds)
LIVE_CACHE_TTL_FX_SECONDS=60
LIVE_CACHE_TTL_STOCK_SECONDS=30
LIVE_CACHE_TTL_COMMODITY_SECONDS=30
LIVE_CACHE_TTL_WEATHER_CURRENT_SECONDS=300
LIVE_CACHE_TTL_WEATHER_FORECAST_SECONDS=900
LIVE_CACHE_TTL_NEWS_SECONDS=180
LIVE_CACHE_TTL_SPORTS_SECONDS=30
GEOCODING_CACHE_TTL_SECONDS=86400

# Market data provider: yahoo (default) or finnhub
MARKET_DATA_PROVIDER=yahoo
# FINNHUB_API_KEY=

# Web connectors (Tavily search, Perplexity research, Firecrawl scrape)
# WEB_SEARCH_PROVIDER=auto
# Options: auto | tavily | perplexity | duckduckgo
# auto prefers Tavily when TAVILY_API_KEY is set, else Perplexity, else DuckDuckGo
# TAVILY_API_KEY=
# PERPLEXITY_API_KEY=   # Search API ($0.005/request) — not Sonar/Pro Search
# FIRECRAWL_API_KEY=

# SYSTEM_PROMPT_PATH=app/prompts/system.md

# Optional: Postgres URL for pg-mcp-server in .cursor/mcp.json (Phase 1)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/personal_ai

# Authentication (Phase 1)
AUTH_DISABLED=true
# ADMIN_EMAILS=you@example.com
# AUTH_SIGNUP_MODE=invite
# SETTINGS_SECRET_KEY=generate-a-long-random-string

# Runtime MCP + agent permissions (Phase C)
ENABLE_RUNTIME_MCP=true
ENABLE_LLM_HISTORY_COMPACTION=true
# BUNDLED_SKILLS_PATH=skills
# USER_SKILLS_PATH=memory/user_skills.json
# AGENT_TASKS_PATH=memory/agent_tasks.json
JWT_SECRET=dev-change-me-in-production
JWT_EXPIRE_MINUTES=10080
DEV_USER_EMAIL=dev@localhost
DEV_USER_DISPLAY_NAME=Dev User
# Google Sign-In (set AUTH_DISABLED=false and configure for production login)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
