# FastAPI configuration
APP_NAME=personal-ai
DEBUG=false

# Ollama configuration
# For Docker: use http://ollama:11434
# For local: use http://127.0.0.1:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120.0

# Pluggable LLM routing (provider adapters + per-stage model selection)
LLM_DEFAULT_PROVIDER=ollama
LLM_DEFAULT_MODEL=llama3:8b
# Optional OpenAI-compatible provider (LM Studio, vLLM, hosted gateways, etc.)
LLM_OPENAI_BASE_URL=
LLM_OPENAI_API_KEY=
LLM_OPENAI_TIMEOUT=60.0
LLM_PLANNER_PROVIDER=ollama
LLM_PLANNER_MODEL=qwen2.5:3b
LLM_SYNTHESIZER_PROVIDER=ollama
LLM_SYNTHESIZER_MODEL=qwen2.5:7b
LLM_REVIEWER_PROVIDER=ollama
LLM_REVIEWER_MODEL=qwen2.5:3b
LLM_WRITER_PROVIDER=ollama
LLM_WRITER_MODEL=llama3:8b

# Qdrant configuration
# For Docker: use http://qdrant:6333
# For local: use http://127.0.0.1:6333
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=personal_ai_documents
QDRANT_DISTANCE=Cosine
EMBEDDING_DIMENSION=768
DEFAULT_TOP_K=4

# UI CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Adapter cache configuration
ENABLE_ADAPTER_CACHE=true
ADAPTER_CACHE_BACKEND=redis
ADAPTER_CACHE_DEFAULT_TTL_SECONDS=60
REDIS_URL=redis://redis:6379/0

# Background workers (Phase 2)
ENABLE_BACKGROUND_WORKERS=false
WORKER_QUEUE_BACKEND=arq
INGEST_ASYNC_MIN_DOCUMENTS=5
INGEST_ASYNC_MIN_BYTES=32768

# Observability defaults
GRAFANA_ADMIN_PASSWORD=admin

# Optional framework toggles
# Fast single-call chat for trivial prompts; tool-calling agent for /chat and Smart chat tier.
ENABLE_FAST_CHAT=true
ENABLE_LANGCHAIN_AGENT=true
ENABLE_LLAMAINDEX_RAG=false

# Workflow orchestration memory
WORKFLOW_MEMORY_PATH=memory/workflow_sessions.json
WORKFLOW_MEMORY_MAX_ENTRIES=24
WORKFLOW_MEMORY_BACKEND=disk
WORKFLOW_RUNS_PATH=memory/runs
RUN_STORE_BACKEND=disk

# Object storage for raw uploads
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_PATH=memory/uploads
# OBJECT_STORAGE_BACKEND=s3
# OBJECT_STORAGE_BUCKET=personal-ai-uploads
# OBJECT_STORAGE_PREFIX=uploads
# OBJECT_STORAGE_ENDPOINT_URL=
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=

# Live data cache TTLs (seconds)
LIVE_CACHE_TTL_FX_SECONDS=60
LIVE_CACHE_TTL_STOCK_SECONDS=30
LIVE_CACHE_TTL_COMMODITY_SECONDS=30
LIVE_CACHE_TTL_WEATHER_CURRENT_SECONDS=300
LIVE_CACHE_TTL_WEATHER_FORECAST_SECONDS=900
LIVE_CACHE_TTL_NEWS_SECONDS=180
GEOCODING_CACHE_TTL_SECONDS=86400

# Market data provider: yahoo (default) or finnhub
MARKET_DATA_PROVIDER=yahoo
# FINNHUB_API_KEY=

# SYSTEM_PROMPT_PATH=app/prompts/system.md

# Optional: Postgres URL for pg-mcp-server in .cursor/mcp.json (Phase 1)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/personal_ai

# Authentication (Phase 1)
AUTH_DISABLED=true
JWT_SECRET=dev-change-me-in-production
JWT_EXPIRE_MINUTES=10080
DEV_USER_EMAIL=dev@localhost
DEV_USER_DISPLAY_NAME=Dev User
# Google Sign-In (set AUTH_DISABLED=false and configure for production login)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
