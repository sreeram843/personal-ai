  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Live adapter requests by domain",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (domain) (rate(live_adapter_requests_total[5m]))",
          "legendFormat": "{{domain}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Live adapter error rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(live_adapter_requests_total{status=\"error\"}[5m])) / clamp_min(sum(rate(live_adapter_requests_total[5m])), 0.001)",
          "legendFormat": "error_rate",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "title": "Adapter latency p95 by domain",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, domain) (rate(live_adapter_latency_seconds_bucket[5m])))",
          "legendFormat": "{{domain}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 4,
      "title": "Live adapter errors by domain",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (domain) (rate(live_adapter_requests_total{status=\"error\"}[5m]))",
          "legendFormat": "{{domain}}",
          "refId": "A"
        }
      ]
    }
  ],
