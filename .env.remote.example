# Remote inference — app on MacBook, models on Mac Mini (LM Studio + Ollama).
#
# Mac Mini host — use Ethernet LAN IP or Tailscale IP:
#   Ethernet:  192.168.10.1
#   Tailscale: 100.67.46.46  (sriram-menteys-macmini)
#
# Mac Mini prerequisites:
#   1. LM Studio: load a chat model → Developer → Start server (port 1234)
#      → enable "Serve on local network"
#   2. Ollama: export OLLAMA_HOST=0.0.0.0:11434 → ollama pull nomic-embed-text
#   3. From MacBook:
#        curl http://192.168.10.1:1234/api/v1/models   # LM Studio (native API)
#        curl http://192.168.10.1:1234/v1/models       # OpenAI-compatible list (use "id" for .env)
#        curl http://192.168.10.1:11434/api/tags       # Ollama embeddings
#
# Usage on MacBook:
#   cp .env.remote.example .env.remote
#   # Set LLM_*_MODEL to the id from /v1/models (e.g. qwen-3-14b-instruct)
#   make up-remote
#   make db-migrate   # first run only

APP_NAME=personal-ai
DEBUG=false

# ── Mac Mini: Ollama (embeddings only) ───────────────────────────────────────
OLLAMA_BASE_URL=http://192.168.10.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=
OLLAMA_TIMEOUT=120.0

# ── Mac Mini: LM Studio (chat via OpenAI-compatible API) ─────────────────────
# Base URL without /v1 — app appends /v1/chat/completions
LLM_DEFAULT_PROVIDER=openai
LLM_OPENAI_BASE_URL=http://192.168.10.1:1234
LLM_OPENAI_API_KEY=lm-studio
LLM_OPENAI_TIMEOUT=120.0

# Copy exact "id" from: curl http://192.168.10.1:1234/v1/models
# LM Studio serves one loaded model — set the same id on every LLM_*_MODEL line.
LLM_DEFAULT_MODEL=qwen-3-14b-instruct
LLM_PLANNER_PROVIDER=openai
LLM_PLANNER_MODEL=qwen-3-14b-instruct
LLM_SYNTHESIZER_PROVIDER=openai
LLM_SYNTHESIZER_MODEL=qwen-3-14b-instruct
LLM_REVIEWER_PROVIDER=openai
LLM_REVIEWER_MODEL=qwen-3-14b-instruct
LLM_WRITER_PROVIDER=openai
LLM_WRITER_MODEL=qwen-3-14b-instruct

# ── Qdrant / embeddings ──────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=personal_ai_documents
QDRANT_DISTANCE=Cosine
EMBEDDING_DIMENSION=768
DEFAULT_TOP_K=4

# ── Chat execution ───────────────────────────────────────────────────────────
ENABLE_FAST_CHAT=true
ENABLE_LANGCHAIN_AGENT=true
ENABLE_LLAMAINDEX_RAG=false

# ── Cache / queue ──────────────────────────────────────────────────────────────
ENABLE_ADAPTER_CACHE=true
ADAPTER_CACHE_BACKEND=redis
ADAPTER_CACHE_DEFAULT_TTL_SECONDS=60
REDIS_URL=redis://redis:6379/0

ENABLE_BACKGROUND_WORKERS=false
WORKER_QUEUE_BACKEND=arq

# ── Auth (local dev) ─────────────────────────────────────────────────────────
AUTH_DISABLED=true
JWT_SECRET=dev-change-me-in-production
JWT_EXPIRE_MINUTES=10080
DEV_USER_EMAIL=dev@localhost
DEV_USER_DISPLAY_NAME=Dev User
# Google Sign-In (set AUTH_DISABLED=false; origins must include http://localhost:8000)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/personal_ai

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

WORKFLOW_MEMORY_BACKEND=disk
WORKFLOW_RUNS_PATH=memory/runs
RUN_STORE_BACKEND=disk
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_PATH=memory/uploads

LIVE_CACHE_TTL_FX_SECONDS=60
LIVE_CACHE_TTL_STOCK_SECONDS=30
LIVE_CACHE_TTL_COMMODITY_SECONDS=30
LIVE_CACHE_TTL_WEATHER_CURRENT_SECONDS=300
LIVE_CACHE_TTL_WEATHER_FORECAST_SECONDS=900
LIVE_CACHE_TTL_NEWS_SECONDS=180
GEOCODING_CACHE_TTL_SECONDS=86400
MARKET_DATA_PROVIDER=yahoo

GRAFANA_ADMIN_PASSWORD=admin
