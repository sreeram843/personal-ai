# Cloud-chat local/prod overlay — copy to .env.cloud and fill in values.
# Usage: make up-cloud
# NEVER commit the filled-in .env.cloud file.
#
# Ollama stays for embeddings only (nomic-embed-text). Chat providers after
# bootstrap are managed in Admin → Providers / Routing (not by swapping blocks here).

# ── Cold-start LLM fallback (pick ONE OpenAI-compatible endpoint) ─────────────
# Registers as provider "openai" when that name is not in the Admin DB.
# Examples:
#   Groq:      https://api.groq.com/openai
#   DeepSeek:  https://api.deepseek.com
#   OpenAI:    https://api.openai.com
#   Together:  https://api.together.xyz
#   Fireworks: https://api.fireworks.ai/inference
#
LLM_CLOUD_BASE_URL=https://api.groq.com/openai
LLM_CLOUD_API_KEY=your-cloud-api-key-here
LLM_CLOUD_DEFAULT_MODEL=llama-3.1-8b-instant
LLM_CLOUD_PLANNER_MODEL=llama-3.1-8b-instant
LLM_CLOUD_SYNTHESIZER_MODEL=llama-3.3-70b-versatile
LLM_CLOUD_REVIEWER_MODEL=llama-3.1-8b-instant
LLM_CLOUD_WRITER_MODEL=llama-3.3-70b-versatile
LLM_CLOUD_TIMEOUT=30.0
ENABLE_TOOL_AGENT=false

# ── Auth / admin ──────────────────────────────────────────────────────────────
# Local testing: AUTH_DISABLED=true
# Production: AUTH_DISABLED=false + Google OAuth origins for app + admin hosts
#
# AUTH_DISABLED=false
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# JWT_SECRET=generate-a-long-random-string-at-least-32-chars
# JWT_EXPIRE_MINUTES=10080
# ADMIN_EMAILS=you@example.com
# AUTH_SIGNUP_MODE=invite
# SETTINGS_SECRET_KEY=generate-another-long-random-string
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,https://app.cura-i.com,https://admin.cura-i.com,capacitor://localhost,ionic://localhost

# ── Web search / scrape (Admin Providers do NOT replace these) ────────────────
# TAVILY_API_KEY=
# PERPLEXITY_API_KEY=
# FIRECRAWL_API_KEY=

# ── Portfolio embed demo (/demo) ──────────────────────────────────────────────
# DEMO_ENABLED=true
# DEMO_MAX_QUESTIONS=5
# DEMO_FULL_APP_URL=https://app.cura-i.com
# DEMO_CONTEXT_MAX_CHARS=12000
# DEMO_EMBED_ALLOWED_ORIGINS=https://yourname.dev,https://www.yourname.dev
# DEMO_INTRO=Ask about my work in AI, healthcare engineering, academics, or cricket — or try a live weather/FX question.

# ── HTTPS subdomains (Caddy on prod VM) ───────────────────────────────────────
# CADDY_APP_DOMAIN=app.cura-i.com
# CADDY_ADMIN_DOMAIN=admin.cura-i.com
# CADDY_GRAFANA_DOMAIN=grafana.app.cura-i.com
# CADDY_ACME_EMAIL=you@example.com
# GRAFANA_ROOT_URL=https://grafana.app.cura-i.com
# GRAFANA_DOMAIN=grafana.app.cura-i.com
# GRAFANA_ADMIN_PASSWORD=change-me-strong-password
