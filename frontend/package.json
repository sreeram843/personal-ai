{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "browserslist": {
    "production": [
      "defaults",
      "not dead",
      "safari >= 16",
      "ios_saf >= 16"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:capacitor": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/ui-flows.spec.ts",
    "test:capacitor": "playwright test tests/capacitor-mobile.spec.ts",
    "test:ui": "playwright test",
    "test:visual": "playwright test tests/ui-visual.spec.ts",
    "test:ui:update": "playwright test --update-snapshots",
    "test:visual:update:linux": "bash ../scripts/update_playwright_linux_snapshots.sh",
    "cap:sync": "npm run build:capacitor && npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:ios": "npx cap open ios",
    "cap:run:ios": "npx cap run ios",
    "cap:android": "npx cap open android",
    "cap:doctor": "npx cap doctor"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-social-login": "^8.3.30",
    "@react-oauth/google": "^0.12.2",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "mermaid": "^11.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.9",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/android": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.9"
  }
}
