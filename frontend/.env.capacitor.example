# Copy to .env.capacitor.local and source before native builds.
# Required: Capacitor WebView cannot use same-origin API fallback.
VITE_API_BASE_URL=http://localhost:8000

# Backend must allow Capacitor WebView origins (add to CORS_ORIGINS in .env):
# capacitor://localhost,ionic://localhost

# Optional: live-reload against Vite dev server (device must reach this host)
# CAPACITOR_SERVER_URL=http://192.168.1.10:5173
