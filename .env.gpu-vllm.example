# GPU vLLM configuration — copy to .env.gpu-vllm and adjust.
# Usage: make up-gpu-vllm
#
# NEVER commit the filled-in version of this file.

# Hugging Face token (required for gated models like Llama)
HF_TOKEN=your-hf-token-here

# Model served by the vLLM container (must match pulled weights / HF repo id)
VLLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Per-role chat models (OpenAI-compatible names as exposed by vLLM)
VLLM_CHAT_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
VLLM_PLANNER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
VLLM_SYNTHESIZER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
VLLM_REVIEWER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
VLLM_WRITER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Dummy API key for the in-cluster vLLM OpenAI shim
VLLM_API_KEY=local-vllm
VLLM_TIMEOUT=120.0
